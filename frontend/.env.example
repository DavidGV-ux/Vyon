# Supabase (frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API base used by the SPA (optional; defaults to same origin)
VITE_API_URL=http://localhost:3000

# --- Server (backend) ---

# Provider selection: anthropic | openai | deterministic
AI_PROVIDER=deterministic
AI_TIMEOUT_MS=3800
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Anthropic (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI-compatible (required when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Whisper (audio transcription)
WHISPER_PROVIDER=openai
WHISPER_API_BASE=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=es

# Supabase Auth verification (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
AUTH_REQUIRED=false

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
REQUEST_BUDGET_MS=3800
CORS_ORIGIN=http://localhost:5173

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=60000

# --- MECL-056: WhatsApp retention + reactivation (Twilio) ---
WHATSAPP_PROVIDER=twilio
WHATSAPP_DEFAULT_LANGUAGE=es
WHATSAPP_RETENTION_ENABLED=true
WHATSAPP_RETENTION_THRESHOLD_DAYS=30
WHATSAPP_REACTIVATION_ENABLED=true
WHATSAPP_REACTIVATION_DELAYS=0,3,7
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_BASE=https://api.twilio.com
TWILIO_TIMEOUT_MS=8000

# --- MECL-058: token optimization ---
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX_ENTRIES=200
AI_MAX_TOKENS_RESUMENES=1200
AI_MAX_TOKENS_TAREAS=1600
AI_MAX_TOKENS_FINANZAS=1600
